NODE_ENV=development
PORT=3000
API_TOKEN=replace-with-a-long-random-token

# SQLite works immediately after installing dependencies.
DB_CLIENT=sqlite3
DB_FILENAME=database/dev.sqlite

# For MySQL, set DB_CLIENT=mysql2 and provide the connection values.
# DB_CLIENT=mysql2
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=app_user
# DB_PASSWORD=change-me
# DB_DATABASE=knex_tutorial
